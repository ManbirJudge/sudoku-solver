<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title"
            android:labelFor="@+id/bug_report_title_edit"/>
        <EditText
            android:id="@+id/bug_report_title_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:autofillHints=""/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:labelFor="@+id/bug_report_desc_edit"
            android:layout_marginTop="10dp"/>
        <EditText
            android:id="@+id/bug_report_desc_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:inputType="textMultiLine"
            android:lines="2"
            android:scrollbars="vertical"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bug Type"
            android:labelFor="@+id/bug_report_type_spinner"
            android:layout_marginTop="10dp"/>
        <Spinner
            android:id="@+id/bug_report_type_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/bug_report_send_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:layout_marginTop="10dp"/>
        <TextView
            android:id="@+id/bug_report_email_us_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="OR email us directly at manbirjudge2009@gmail.com"
            android:textAlignment="center"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"/>
    </LinearLayout>
</ScrollView>